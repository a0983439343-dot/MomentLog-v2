{
  "rules": {
    "users": {
      ".read": "auth != null && auth.uid === 'nJdwA4Heqrbtqdt1atbiOsVi7r23'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === 'nJdwA4Heqrbtqdt1atbiOsVi7r23')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "fcmTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "rooms": {
      ".read": "auth != null && auth.uid === 'nJdwA4Heqrbtqdt1atbiOsVi7r23'",

      "$roomId": {
        ".read": "auth != null && (auth.uid === 'nJdwA4Heqrbtqdt1atbiOsVi7r23' || data.child('members').child(auth.uid).exists())",

        "meta": {
          ".read": "auth != null && (auth.uid === 'nJdwA4Heqrbtqdt1atbiOsVi7r23' || root.child('rooms').child($roomId).child('members').child(auth.uid).exists())",

          ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.exists() && data.child('ownerUid').val() === auth.uid))",

          ".validate": "newData.hasChildren(['ownerUid']) && newData.child('ownerUid').isString() && newData.child('ownerUid').val().length > 0"
        },

        "members": {
          "$uid": {
            ".read": "auth != null && (auth.uid === 'nJdwA4Heqrbtqdt1atbiOsVi7r23' || root.child('rooms').child($roomId).child('members').child(auth.uid).exists())",

            ".write": "auth != null && ((auth.uid === $uid && newData.exists()) || (auth.uid === $uid && !newData.exists()) || (root.child('rooms').child($roomId).child('meta').child('ownerUid').val() === auth.uid && auth.uid !== $uid))"
          }
        },

        "records": {
          ".read": "auth != null && (auth.uid === 'nJdwA4Heqrbtqdt1atbiOsVi7r23' || data.parent().parent().parent().child('members').child(auth.uid).exists())",

          "$date": {
            "$hour": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()"
              }
            }
          }
        },

        "notificationSettings": {
          "$uid": {
            ".read": "auth != null && (auth.uid === 'nJdwA4Heqrbtqdt1atbiOsVi7r23' || (auth.uid === $uid && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()))",

            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()"
          }
        }
      }
    },

    "system": {
      "broadcast": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === 'nJdwA4Heqrbtqdt1atbiOsVi7r23'",
        ".validate": "newData.hasChildren(['text','timestamp','senderUid']) && newData.child('text').isString() && newData.child('timestamp').isNumber() && newData.child('senderUid').val() === auth.uid"
      }
    }
  }
}

{
  "rules": {
    "users": {
      ".read": "auth != null && auth.uid === 'nJdwA4Heqrbtqdt1atbiOsVi7r23'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === 'nJdwA4Heqrbtqdt1atbiOsVi7r23')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "fcmTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "rooms": {
      ".read": "auth != null && auth.uid === 'nJdwA4Heqrbtqdt1atbiOsVi7r23'",

      "$roomId": {
        ".read": "auth != null && (auth.uid === 'nJdwA4Heqrbtqdt1atbiOsVi7r23' || data.child('members').child(auth.uid).exists())",

        ".write": "auth != null && !data.exists() && newData.child('meta').child('ownerUid').val() === auth.uid && newData.child('members').child(auth.uid).exists()",

        ".validate": "newData.hasChildren(['meta','members']) && newData.child('meta').hasChildren(['ownerUid']) && newData.child('meta').child('ownerUid').isString() && newData.child('meta').child('ownerUid').val().length > 0 && newData.child('members').child(newData.child('meta').child('ownerUid').val()).exists()",

        "meta": {
          ".read": "auth != null",

          ".write": "auth != null && data.exists() && data.child('ownerUid').val() === auth.uid && newData.exists() && newData.child('ownerUid').isString() && (newData.child('ownerUid').val() === data.child('ownerUid').val() || root.child('rooms').child($roomId).child('members').child(newData.child('ownerUid').val()).exists())",

          ".validate": "newData.hasChildren(['ownerUid']) && newData.child('ownerUid').isString() && newData.child('ownerUid').val().length > 0 && (newData.child('ownerUid').val() === data.child('ownerUid').val() || (data.child('ownerUid').val() === auth.uid && root.child('rooms').child($roomId).child('members').child(newData.child('ownerUid').val()).exists()))"
        },

        "members": {
          "$uid": {
            ".read": "auth != null && (auth.uid === 'nJdwA4Heqrbtqdt1atbiOsVi7r23' || root.child('rooms').child($roomId).child('members').child(auth.uid).exists())",

            ".write": "auth != null && ((auth.uid === $uid && (newData.exists() || root.child('rooms').child($roomId).child('meta').child('ownerUid').val() !== auth.uid)) || (root.child('rooms').child($roomId).child('meta').child('ownerUid').val() === auth.uid && auth.uid !== $uid))"
          }
        },

        "records": {
          "$date": {
            "$hour": {
              "$uid": {
                ".read": "auth != null && (auth.uid === 'nJdwA4Heqrbtqdt1atbiOsVi7r23' || root.child('rooms').child($roomId).child('members').child(auth.uid).exists())",

                ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()"
              }
            }
          }
        },

        "notificationSettings": {
          "$uid": {
            ".read": "auth != null && (auth.uid === 'nJdwA4Heqrbtqdt1atbiOsVi7r23' || (auth.uid === $uid && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()))",

            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()"
          }
        }
      }
    },

    "system": {
      "broadcast": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === 'nJdwA4Heqrbtqdt1atbiOsVi7r23'",
        ".validate": "newData.hasChildren(['text','timestamp','senderUid']) && newData.child('text').isString() && newData.child('timestamp').isNumber() && newData.child('senderUid').val() === auth.uid"
      }
    }
  }
}

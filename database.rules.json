{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.hasChildren(['displayName']) && newData.child('displayName').isString() && newData.child('displayName').val().length > 0 && newData.child('displayName').val().length <= 30)"
      }
    },
    "rooms": {
      "$roomId": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (( !data.exists() && newData.exists() && newData.child('roomId').val() === $roomId && newData.child('ownerUid').val() === auth.uid ) || (data.exists() && root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && (newData.child('ownerUid').val() === data.child('ownerUid').val() || data.child('ownerUid').val() === auth.uid)))"
        },
        "members": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('meta').exists()",
            ".validate": "!newData.exists() || (newData.hasChildren(['displayName','joinedAt','updatedAt']) && newData.child('displayName').isString() && newData.child('displayName').val().length > 0 && newData.child('displayName').val().length <= 30)"
          }
        },
        "records": {
          "$date": {
            "$hour": {
              ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()",
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && ((!newData.exists()) || (newData.child('authorUid').val() === auth.uid && newData.child('date').val() === $date && newData.child('hour').val() == $hour))",
                ".validate": "!newData.exists() || (newData.hasChildren(['date','hour','authorUid','updatedAt']) && newData.child('date').isString() && newData.child('hour').isNumber() && newData.child('authorUid').val() === auth.uid && newData.child('updatedAt').isNumber())"
              }
            }
          }
        },
        "notificationSettings": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()"
          }
        }
      }
    },
    "fcmTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$tokenKey": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || (newData.hasChildren(['token','updatedAt']) && newData.child('token').isString() && newData.child('updatedAt').isNumber())"
        }
      }
    },
    "reminderDeliveries": {
      ".read": false,
      ".write": false
    }
  }
}
